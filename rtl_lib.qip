# Add to a Quartus project: set_global_assignment -name QIP_FILE <path>/rtl_lib.qip
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "rtl_lib/pkg/rtl_utils_pkg.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "rtl_lib/cdc/async_fifo.sv"]
