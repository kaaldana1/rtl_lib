set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "rtl_lib/memory/ram_1r1w.sv"]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) "rtl_lib/memory/register_file.sv"]
